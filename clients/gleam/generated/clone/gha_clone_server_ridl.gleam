/// The wire value for a `RunStatus`.
pub fn run_status_to_wire(value: RunStatus) -> String {
  case value {
    Queued -> "queued"
    Running -> "running"
    Succeeded -> "succeeded"
    Failed -> "failed"
  }
}

pub fn run_status_from_wire(wire: String) -> Result(RunStatus, String) {
  case wire {
    "queued" -> Ok(Queued)
    "running" -> Ok(Running)
    "succeeded" -> Ok(Succeeded)
    "failed" -> Ok(Failed)
    other -> Error("not a RunStatus variant: " <> other)
  }
}

