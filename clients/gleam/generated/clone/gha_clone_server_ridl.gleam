/// Escape one path segment so an id containing `/` cannot reshape the URL.
pub fn encode_segment(value: String) -> String {
  value
  |> string.replace("%", "%25")
  |> string.replace("/", "%2F")
  |> string.replace("?", "%3F")
  |> string.replace("#", "%23")
  |> string.replace(" ", "%20")
}

